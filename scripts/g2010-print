#!/bin/bash
# Print a file on the Canon G2010 without the Canon driver.
#   PDF/images/text -> one PDF per page -> CUPS raster (Apple filters)
#   -> Gutenprint -> USB (one raw job per page)
# The G2010 delivers pages face up, so pages are sent last-to-first by default
# and the stack comes out in reading order (--no-reverse to disable).
# --pages picks pages: "odd", "even", or a list such as "1,3,5-9" (default: all).
#   Office documents must be exported to PDF first (see the error message).
# The job is sent raw, so the queue's own (Canon) filters are bypassed.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STAGE="$ROOT/build/stage"
PPD="$ROOT/build/ppd/stp-bjc-G2000-series.5.3.ppd"
FILTER="$STAGE/usr/libexec/cups/filter/rastertogutenprint.5.3"
QUEUE="${G2010_QUEUE:-Canon_G2010_series}"
PAPER="A4"
COPIES=1
DRY=0
REVERSE=1
PAGES=""
TOOL="$ROOT/build/bin/pdf-tool"

usage() { echo "usage: $0 [-q queue] [-p PageSize] [-n copies] [--pages SPEC] [--no-reverse] [--dry-run] file" >&2; exit 2; }
while [ $# -gt 0 ]; do
  case "$1" in
    -q) QUEUE="$2"; shift 2;;
    -p) PAPER="$2"; shift 2;;
    -n) COPIES="$2"; shift 2;;
    --dry-run) DRY=1; shift;;
    --pages) PAGES="$2"; shift 2;;
    --no-reverse) REVERSE=0; shift;;
    -h|--help) usage;;
    --) shift; break;;
    -*) usage;;
    *) break;;
  esac
done
[ $# -eq 1 ] || usage
FILE="$1"
[ -f "$FILE" ] || { echo "no such file: $FILE" >&2; exit 1; }
[ -x "$FILTER" ] && [ -f "$PPD" ] || { echo "run scripts/build-gutenprint.sh first" >&2; exit 1; }
lpstat -p "$QUEUE" >/dev/null 2>&1 || { echo "CUPS queue not found: $QUEUE" >&2; exit 1; }

TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
case "$(echo "${FILE##*.}" | tr A-Z a-z)" in
  docx|doc|pages|xlsx|pptx|key|numbers)
    # Word/Pages are sandboxed and cannot be driven reliably from a script
    # (they pop up "Grant File Access" dialogs), so export a PDF yourself first:
    # File > Export As > PDF (or File > Print > PDF > Save as PDF).
    echo "Export $FILE to PDF first, then print the PDF." >&2
    exit 1
    ;;
esac

export STP_DATA_PATH="$STAGE/usr/local/share/gutenprint/5.3/xml"
export STP_MODULE_PATH="$STAGE/usr/local/lib/gutenprint/5.3/modules"
export DYLD_LIBRARY_PATH="$STAGE/usr/local/lib"
export PPD

# Progress lines starting with "@@" on stderr are read by the app (app/PrintG2010.swift):
#   @@total N   pages to send (pages x copies)     @@convert K   converting page K
#   @@job ID    CUPS job created                   @@page A/N    A of N pages sent
if [ ! -x "$TOOL" ] || [ "$ROOT/app/pdf-tool.swift" -nt "$TOOL" ]; then
  mkdir -p "$(dirname "$TOOL")"
  swiftc -O -o "$TOOL" "$ROOT/app/pdf-tool.swift" || { echo "cannot build pdf-tool (needs Xcode command line tools)" >&2; exit 1; }
fi

case "$(echo "${FILE##*.}" | tr A-Z a-z)" in
  pdf) PDF="$FILE";;
  *)
    echo "@@prepare" >&2
    cupsfilter -m application/pdf "$FILE" >"$TMP/in.pdf" 2>"$TMP/pdf.err" || { echo "cannot convert to PDF: $(tail -n 2 "$TMP/pdf.err")" >&2; exit 1; }
    PDF="$TMP/in.pdf";;
esac
N="$("$TOOL" split "$PDF" "$TMP/pages")" || exit 1

# Prints the chosen page numbers, ascending and without duplicates.
select_pages() {
  local spec="${PAGES//[[:space:]]/}" part a b parts
  [ -n "$spec" ] || { seq "$N"; return; }
  IFS=',' read -ra parts <<<"$spec"
  for part in "${parts[@]}"; do
    case "$part" in
      odd) seq 1 2 "$N";;
      even) [ "$N" -lt 2 ] || seq 2 2 "$N";;
      *)
        if [[ "$part" =~ ^[0-9]+$ ]]; then a="$part"; b="$part"
        elif [[ "$part" =~ ^([0-9]+)-([0-9]+)$ ]]; then a="${BASH_REMATCH[1]}"; b="${BASH_REMATCH[2]}"
        else echo "invalid page selection: '$part' (use e.g. 1,3,5-9, odd or even)" >&2; return 1; fi
        if [ "$a" -lt 1 ] || [ "$a" -gt "$b" ]; then echo "invalid page range: '$part'" >&2; return 1; fi
        if [ "$b" -gt "$N" ]; then echo "page $b is out of range (the document has $N pages)" >&2; return 1; fi
        seq "$a" "$b";;
    esac
  done
}
PAGELIST="$(select_pages | sort -nu)" || exit 1
[ -n "$PAGELIST" ] || { echo "no pages selected (the document has $N pages)" >&2; exit 1; }
if [ "$REVERSE" = 1 ]; then ORDER="$(echo "$PAGELIST" | sort -rn)"; else ORDER="$PAGELIST"; fi
NSEL="$(echo "$PAGELIST" | wc -l | tr -d ' ')"
TOTAL=$((NSEL * COPIES))
echo "@@total $TOTAL" >&2

convert_page() {
  echo "@@convert $1" >&2
  if ! cupsfilter -p "$PPD" -m application/vnd.cups-raster -o "PageSize=$PAPER" "$TMP/pages/p$1.pdf" 2>"$TMP/cf.err" \
      | "$FILTER" 1 "$USER" g2010-print 1 "PageSize=$PAPER" 2>"$TMP/gp.err" >"$TMP/p$1.bjl" \
      || [ ! -s "$TMP/p$1.bjl" ]; then
    echo "conversion of page $1 failed: $(tail -n 2 "$TMP/cf.err" "$TMP/gp.err" 2>/dev/null | grep -v '^==>' | tr '\n' ' ')" >&2
    exit 1
  fi
}

SENT=0
for _ in $(seq "$COPIES"); do
  for k in $ORDER; do
    [ -s "$TMP/p$k.bjl" ] || convert_page "$k"
    [ "$DRY" = 1 ] && continue
    out="$(lp -d "$QUEUE" -o raw -t "$(basename "$FILE") p.$k" "$TMP/p$k.bjl")"
    echo "$out"
    echo "@@job $(echo "$out" | awk '/^request id is/{print $4}')" >&2
    SENT=$((SENT + 1))
    echo "@@page $SENT/$TOTAL" >&2
  done
done
[ "$DRY" = 1 ] && echo "dry run ok: $NSEL page(s) converted, not sent" >&2
exit 0
